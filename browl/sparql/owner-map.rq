# The blank nodes of OWL's RDF mapping, with their triples and their IRI parents, for the blank-node owner map
# (browl.precache.owner_map; DESIGN.md §2.5, which says why they're found by type and predicate, not isBlank). A blank
# node's label is its store's (Jena's afn:bnode), which holds across queries. A node found in several ways gives its
# rows several times. Each row is a node's triple (?predicate, and ?object or the blank ?blank) or a triple from an IRI
# ?parent to it. The prologue (browl.precache.core.PREFIXES) and the dataset clause are added when it's run.
SELECT ?node ?predicate ?object ?blank ?parent
WHERE {
  {
    {
      VALUES ?type {
        owl:Axiom owl:Annotation owl:Restriction owl:AllDisjointClasses owl:AllDisjointProperties owl:AllDifferent
        owl:NegativePropertyAssertion <http://www.w3.org/2003/11/swrl#Imp>
      }
      ?b rdf:type ?type
    }
    UNION
    {
      VALUES ?link {
        owl:unionOf owl:intersectionOf owl:complementOf owl:oneOf owl:onDatatype owl:datatypeComplementOf
        owl:withRestrictions owl:inverseOf rdf:first
      }
      ?b ?link ?any
    }
    UNION
    { ?list rdf:first ?b }
    FILTER isBlank(?b)
  }
  BIND (<http://jena.apache.org/ARQ/function#bnode>(?b) AS ?node)
  {
    ?b ?predicate ?value
    BIND (IF(isBlank(?value), <http://jena.apache.org/ARQ/function#bnode>(?value), ?unbound) AS ?blank)
    BIND (IF(isBlank(?value), ?unbound, ?value) AS ?object)
  }
  UNION
  {
    ?parent ?predicate ?b
    FILTER isIRI(?parent)
  }
}
