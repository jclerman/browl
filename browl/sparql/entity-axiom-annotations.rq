# The reified axioms (owl:Axiom) that annotate an entity's logical axioms, with the owl:Annotations nested on them, for
# its fragment (browl.axioms.fetch_fragment; DESIGN.md §2.8, Axiom annotations): those whose owl:annotatedSource is
# the entity, but for its annotation assertions (by entity-annotations.rq's test), or one of the blank-node roots
# entity-axioms.rq finds (the same path); and those of the symmetric axioms other entities state with it as the object
# (entity-symmetric.rq). DESCRIBE adds each node's closure, so a blank owl:annotatedTarget comes with its class
# expression. `$entity` stands for the entity's IRI, and browl.axioms adds the dataset clause before WHERE.
DESCRIBE ?node
WHERE {
  {
    ?axiom owl:annotatedSource $entity ;
      owl:annotatedProperty ?property .
    FILTER (!(
      # Begin the annotation-property test, the same in each copy, as tests/test_sparql.py checks.
      ?property IN (rdfs:label, rdfs:comment, rdfs:seeAlso, rdfs:isDefinedBy, owl:deprecated, owl:versionInfo,
                    owl:priorVersion, owl:backwardCompatibleWith, owl:incompatibleWith)
      || (!STRSTARTS(STR(?property), "http://www.w3.org/1999/02/22-rdf-syntax-ns#")
          && !STRSTARTS(STR(?property), "http://www.w3.org/2000/01/rdf-schema#")
          && !STRSTARTS(STR(?property), "http://www.w3.org/2002/07/owl#")
          && !STRSTARTS(STR(?property), "http://www.w3.org/2001/XMLSchema#")
          && (EXISTS { ?property rdf:type owl:AnnotationProperty }
              || NOT EXISTS {
                ?property rdf:type ?logical
                FILTER (?logical IN (owl:ObjectProperty, owl:DatatypeProperty, owl:FunctionalProperty,
                                     owl:InverseFunctionalProperty, owl:TransitiveProperty, owl:SymmetricProperty,
                                     owl:AsymmetricProperty, owl:ReflexiveProperty, owl:IrreflexiveProperty))
              }))
      # End the annotation-property test.
    ))
  }
  UNION
  {
    # Begin the root path, the same in each copy, as tests/test_sparql.py checks.
    ?root (rdfs:subClassOf|owl:equivalentClass|owl:disjointWith|owl:equivalentProperty|owl:propertyDisjointWith
          |owl:sameAs|owl:differentFrom|owl:members|owl:distinctMembers|owl:sourceIndividual)?
          /(owl:intersectionOf|owl:unionOf|owl:complementOf|owl:someValuesFrom|owl:allValuesFrom|owl:onClass
            |rdf:first|rdf:rest)* $entity
    FILTER isBlank(?root)
    FILTER NOT EXISTS { ?parent ?link ?root FILTER (?link NOT IN (owl:annotatedSource, owl:annotatedTarget)) }
    # End the root path.
    ?axiom owl:annotatedSource ?root
  }
  UNION
  {
    VALUES ?predicate {
      owl:disjointWith owl:equivalentClass owl:equivalentProperty owl:propertyDisjointWith owl:inverseOf owl:sameAs
      owl:differentFrom
    }
    ?axiom owl:annotatedTarget $entity ;
      owl:annotatedProperty ?predicate ;
      owl:annotatedSource ?subject .
    FILTER isIRI(?subject)
  }
  ?node owl:annotatedSource* ?axiom
}
