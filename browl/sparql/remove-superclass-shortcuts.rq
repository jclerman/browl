PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>

# Delete shortcut rdfs:subClassOf links: X ⊑ Z where another parent Y of X already gives X the superclass Z, by
#  1. Y ⊑ Z2, or
#  2. Y = `p some W` for a transitive p, and W ⊑ Z2 (finger part_of hand, hand part_of body),
# where Z2 is Z itself, or a separate restriction node with Z's property and filler (both `p some T`).
# The UNION's two branches match 1 and 2; the FILTER after it checks Z2 against Z.
# Assumes no rdfs:subClassOf cycles, as after `robot reason`, which removes them; else a cycle's shortcuts all go.
DELETE { ?sub rdfs:subClassOf ?super }
WHERE {
  ?sub rdfs:subClassOf ?super, ?mid .
  FILTER (?mid NOT IN (?sub, ?super))
  { ?mid rdfs:subClassOf ?super2 }
  UNION
  { ?mid a owl:Restriction ;
      owl:onProperty ?p ;
      owl:someValuesFrom/rdfs:subClassOf ?super2 .
    ?p a owl:TransitiveProperty .
    ?super2 a owl:Restriction ;
      owl:onProperty ?p
  }
  FILTER (?super2 = ?super || EXISTS {
    ?super a owl:Restriction ;
      owl:onProperty ?q ;
      owl:someValuesFrom ?t .
    ?super2 a owl:Restriction ;
      owl:onProperty ?q ;
      owl:someValuesFrom ?t }
  )
}
