# macOS
.DS_Store

# Temporary files: any directory named tmp, at any depth
tmp/

# Downloads for local runs, such as robot.jar for the tests (make robot-jar)
/.cache/

# Python
__pycache__/
*.py[cod]
.venv/
/build/
/dist/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
# Playwright traces of failed browser tests (--tracing)
/test-results/
# The logs of the tests' Fuseki containers
/test-logs/

# IDE settings
# PyCharm and other JetBrains IDEs
.idea/
*.iml
# VS Code
.vscode/

# Local settings for docker-compose.yml (see .env.example)
.env

# Local PR review notes
docs/pr_reviews/
