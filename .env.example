# Copy to .env, which docker-compose.yml passes to the app. Every setting is in DESIGN.md §2.12.
BASE_URL=http://localhost:8000/

# Development only: authentication off. Otherwise set OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and SEED_ADMINS.
AUTH_DISABLED=true

# docker-compose.yml only, not browl settings: the app's host port, and Fuseki's heap limit (DESIGN.md §2.4).
# BROWL_PORT=8000
# FUSEKI_HEAP=1g
