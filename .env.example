# Copy to .env, which docker-compose.yml passes to the app. Every setting is in DESIGN.md §2.12.
BASE_URL=http://localhost:8000/

# Development only: authentication off. Otherwise set OIDC_CLIENT_ID, OIDC_CLIENT_SECRET and SEED_ADMINS.
AUTH_DISABLED=true

# docker-compose.yml only, not browl settings: the app's host port, Fuseki's heap limit, whose default is in
# docker-compose.yml, and an optional memory limit for Fuseki's container, none by default (DESIGN.md §2.4). If you set
# the container limit, make it about the heap plus 0.5 GiB, and raise it with the heap.
# BROWL_PORT=8000
# FUSEKI_HEAP=2g
# FUSEKI_MEM_LIMIT=2560m
# An optional memory limit for the sandbox's container, where ROBOT runs; none by default. Make it about
# REASONER_MAX_HEAP (8g by default) plus 0.5 GiB, and raise it with REASONER_MAX_HEAP.
# SANDBOX_MEM_LIMIT=8704m
