<?xml version="1.0"?>
<!DOCTYPE Configure PUBLIC "-//Jetty//Configure//EN" "https://jetty.org/configure_10_0.dtd">
<!-- Fuseki's HTTP server, as Fuseki 6.2.0 sets it up without a jetty.xml, except for the output buffer: Jetty's default
     (32 KB) instead of Fuseki's 5 MB. Jetty's buffer pool doesn't keep buffers that large, so with Fuseki's setting each
     response allocates a new 5 MB direct buffer, freed only by garbage collection: hundreds of System.gc() calls a
     minute under load, and a container up to 3.9 GiB with a 1 GB heap (S-6, DESIGN.md §2.4). Jena's fix (apache/jena
     GH-4084: PR #4088 pools the buffers, commit e923f0043 shrinks them to 2 MB) came after 6.2.0. Drop this file once
     browl moves to a Jena release with it, and remeasure then.
     With a jetty.xml, Fuseki skips its own thread pool and error handler, so both are set here as Fuseki sets them. -->
<Configure id="Server" class="org.eclipse.jetty.server.Server">
  <Get name="ThreadPool">
    <Set name="minThreads">2</Set>
    <Set name="maxThreads">20</Set>
  </Get>
  <!-- Fuseki's workaround for Jetty GH-10474: plain-text error responses. -->
  <Set name="errorHandler"><New class="org.apache.jena.fuseki.main.sys.FusekiErrorHandler"/></Set>
  <Call name="addConnector">
    <Arg>
      <New class="org.eclipse.jetty.server.ServerConnector">
        <Arg name="server"><Ref refid="Server"/></Arg>
        <Arg name="factories">
          <Array type="org.eclipse.jetty.server.ConnectionFactory">
            <Item>
              <New class="org.eclipse.jetty.server.HttpConnectionFactory">
                <Arg name="config">
                  <!-- Fuseki's JettyLib.httpConfiguration(), less setOutputBufferSize(5 MB). -->
                  <New class="org.eclipse.jetty.server.HttpConfiguration">
                    <Set name="requestHeaderSize">524288</Set>
                    <Set name="responseHeaderSize">16384</Set>
                    <Set name="sendServerVersion">false</Set>
                  </New>
                </Arg>
              </New>
            </Item>
          </Array>
        </Arg>
        <Set name="port">3030</Set>
      </New>
    </Arg>
  </Call>
</Configure>
