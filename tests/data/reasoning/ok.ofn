Prefix(:=<http://example.org/s2/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)

Ontology(<http://example.org/s2/ok>
  Declaration(Class(:Animal))
  Declaration(Class(:Pet))
  Declaration(Class(:Dog))
  Declaration(Class(:Person))
  Declaration(ObjectProperty(:ownedBy))
  EquivalentClasses(:Pet ObjectIntersectionOf(:Animal ObjectSomeValuesFrom(:ownedBy :Person)))
  SubClassOf(:Dog :Animal)
  SubClassOf(:Dog ObjectSomeValuesFrom(:ownedBy :Person))
)
