Prefix(:=<http://example.org/s2/>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)

Ontology(<http://example.org/s2/inconsistent>
  Declaration(Class(:Plant))
  Declaration(Class(:Animal))
  Declaration(NamedIndividual(:x))
  DisjointClasses(:Plant :Animal)
  ClassAssertion(:Plant :x)
  ClassAssertion(:Animal :x)
)
