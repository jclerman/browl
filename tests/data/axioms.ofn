Prefix(:=<http://example.org/axioms#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)

# Every kind of OWL 2 axiom, for the Manchester rendering tests (tests/test_axioms.py). Each entity's axioms are
# rendered from a fragment fetched from Fuseki and compared with those from the whole ontology. The usage tests
# (tests/test_usages.py) compare each entity's usages with the OWLAPI's.

Ontology(<http://example.org/axioms>
Annotation(rdfs:label "Axioms & <friends>")

Declaration(Class(:Animal))
Declaration(Class(:Plant))
Declaration(Class(:Fungus))
Declaration(Class(:Mineral))
Declaration(Class(:Dog))
Declaration(Class(:Cat))
Declaration(Class(:Person))
Declaration(Class(:Parent))
Declaration(Class(:Child))
Declaration(Class(:Organ))
Declaration(Class(:Heart))
Declaration(Class(:Liver))
Declaration(Class(:Vertebrate))
Declaration(Class(:Pet))
Declaration(Class(:Adult))
Declaration(Class(:Tricky))
Declaration(Class(:LivingThing))
Declaration(ObjectProperty(:partOf))
Declaration(ObjectProperty(:hasPart))
Declaration(ObjectProperty(:hasParent))
Declaration(ObjectProperty(:hasChild))
Declaration(ObjectProperty(:hasAncestor))
Declaration(ObjectProperty(:knows))
Declaration(ObjectProperty(:likes))
Declaration(ObjectProperty(:loves))
Declaration(ObjectProperty(:hates))
Declaration(ObjectProperty(:sibling))
Declaration(ObjectProperty(:hasMother))
Declaration(ObjectProperty(:hasUncle))
Declaration(ObjectProperty(:hasBrother))
Declaration(ObjectProperty(:hasSSN))
Declaration(DataProperty(:age))
Declaration(DataProperty(:years))
Declaration(DataProperty(:name))
Declaration(DataProperty(:nickname))
Declaration(DataProperty(:ssn))
Declaration(DataProperty(:weight))
Declaration(AnnotationProperty(:note))
Declaration(AnnotationProperty(:comment))
Declaration(AnnotationProperty(:remark))
Declaration(Datatype(:Adulthood))
Declaration(Datatype(:Grade))
Declaration(NamedIndividual(:rex))
Declaration(NamedIndividual(:tom))
Declaration(NamedIndividual(:alice))
Declaration(NamedIndividual(:bob))
Declaration(NamedIndividual(:carol))
Declaration(NamedIndividual(:dave))
# Punned: also a class.
Declaration(NamedIndividual(:Dog))

# Display names with HTML special characters.
AnnotationAssertion(rdfs:label :Heart "<b>Heart</b> & \"soul\"")
AnnotationAssertion(rdfs:label :Tricky "a <script>alert(1)</script> 'quote'")
AnnotationAssertion(rdfs:label :partOf "part of")
# Annotations whose values are entities: usages by value (tests/test_usages.py).
AnnotationAssertion(:remark :Cat :Dog)

# Class axioms.
SubClassOf(:Dog :Animal)
SubClassOf(Annotation(:note "annotated") :Cat :Animal)
SubClassOf(:Heart ObjectSomeValuesFrom(:partOf ObjectIntersectionOf(:Animal ObjectComplementOf(:Plant))))
SubClassOf(:Heart :Organ)
SubClassOf(:Liver ObjectAllValuesFrom(:partOf ObjectUnionOf(:Animal :Fungus)))
SubClassOf(:Pet ObjectHasValue(:likes :alice))
SubClassOf(:Person ObjectMinCardinality(1 :hasParent :Person))
SubClassOf(:Person ObjectMaxCardinality(2 :hasParent))
SubClassOf(:Person ObjectExactCardinality(1 :hasMother :Person))
SubClassOf(:Person ObjectHasSelf(:knows))
SubClassOf(:Person DataSomeValuesFrom(:age DatatypeRestriction(xsd:integer xsd:minInclusive "0"^^xsd:integer)))
SubClassOf(:Person DataAllValuesFrom(:name DataUnionOf(xsd:string DataComplementOf(xsd:integer))))
SubClassOf(:Person DataHasValue(:nickname "see <http://example.org/axioms#Dog> & \"friends\""@en))
SubClassOf(:Person DataMinCardinality(1 :name xsd:string))
SubClassOf(:Person DataHasValue(:name "B"^^:Grade))
SubClassOf(:Person DataMaxCardinality(1 :ssn))
SubClassOf(:Person DataExactCardinality(1 :age DataIntersectionOf(xsd:integer DataOneOf("1"^^xsd:integer "2"^^xsd:integer))))
SubClassOf(:Pet ObjectOneOf(:rex :tom))
SubClassOf(:Child ObjectSomeValuesFrom(ObjectInverseOf(:hasChild) :Parent))
SubClassOf(Annotation(:remark :Fungus) :Tricky :Animal)
EquivalentClasses(:Parent ObjectIntersectionOf(:Person ObjectSomeValuesFrom(:hasChild :Person)))
EquivalentClasses(:Adult :Vertebrate :LivingThing)
DisjointClasses(:Dog :Cat)
DisjointClasses(Annotation(:note "n-ary") :Animal :Plant :Fungus)
DisjointClasses(:Mineral ObjectSomeValuesFrom(:partOf :Animal))
DisjointUnion(:LivingThing :Animal :Plant)

# General class axioms.
SubClassOf(ObjectIntersectionOf(:Organ ObjectSomeValuesFrom(:partOf :Plant)) owl:Nothing)
SubClassOf(Annotation(:note "general") ObjectSomeValuesFrom(:hasPart :Heart) :Vertebrate)
SubClassOf(ObjectAllValuesFrom(:partOf ObjectUnionOf(:Dog ObjectComplementOf(:Cat))) :Pet)
SubClassOf(ObjectMinCardinality(2 :hasPart :Liver) :Vertebrate)
EquivalentClasses(ObjectSomeValuesFrom(:loves :Pet) ObjectSomeValuesFrom(:likes :Pet))
DisjointClasses(ObjectSomeValuesFrom(:partOf :Fungus) ObjectSomeValuesFrom(:partOf :Mineral))

HasKey(:Person (:hasSSN) (:ssn))

# Object property axioms.
SubObjectPropertyOf(:hasMother :hasParent)
SubObjectPropertyOf(ObjectPropertyChain(:hasParent :hasParent) :hasAncestor)
SubObjectPropertyOf(ObjectPropertyChain(:hasParent :hasBrother) :hasUncle)
EquivalentObjectProperties(:likes :loves)
DisjointObjectProperties(:likes :hates)
DisjointObjectProperties(:hasParent :hasChild :sibling)
InverseObjectProperties(:hasParent :hasChild)
InverseObjectProperties(:partOf :hasPart)
ObjectPropertyDomain(:hasParent :Person)
ObjectPropertyRange(:hasParent :Person)
FunctionalObjectProperty(:hasMother)
InverseFunctionalObjectProperty(:hasSSN)
ReflexiveObjectProperty(:knows)
IrreflexiveObjectProperty(:hasParent)
SymmetricObjectProperty(:sibling)
AsymmetricObjectProperty(:hasChild)
TransitiveObjectProperty(:partOf)
TransitiveObjectProperty(:hasAncestor)

# Data property axioms.
SubDataPropertyOf(:nickname :name)
EquivalentDataProperties(:age :years)
DisjointDataProperties(:age :weight)
DisjointDataProperties(:name :ssn :weight)
DataPropertyDomain(:age :Person)
DataPropertyRange(:age xsd:nonNegativeInteger)
FunctionalDataProperty(:ssn)

# Datatype definitions.
DatatypeDefinition(:Adulthood DatatypeRestriction(xsd:integer xsd:minInclusive "18"^^xsd:integer))
DatatypeDefinition(:Grade DataOneOf("A" "B" "C"))

# Assertions.
ClassAssertion(:Dog :rex)
ClassAssertion(:Animal :Dog)
ClassAssertion(ObjectSomeValuesFrom(:likes :Pet) :alice)
ObjectPropertyAssertion(:likes :alice :rex)
ObjectPropertyAssertion(:hasChild :alice :bob)
NegativeObjectPropertyAssertion(:hates :alice :rex)
DataPropertyAssertion(:age :alice "42"^^xsd:integer)
DataPropertyAssertion(:name :bob "Bob <bob@example.org>")
NegativeDataPropertyAssertion(:age :bob "7"^^xsd:integer)
SameIndividual(:carol :dave)
DifferentIndividuals(:alice :bob)
DifferentIndividuals(:alice :carol :tom)

# Annotation property axioms.
SubAnnotationPropertyOf(:remark :comment)
AnnotationPropertyDomain(:note :Animal)
AnnotationPropertyRange(:note xsd:string)
)
